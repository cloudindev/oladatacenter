    "var_2f77ffb6845d": {
      "type": "variant",
      "label": "The Command Center (Dark Mode)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "generation": {
        "prompt": "",
        "config": {}
