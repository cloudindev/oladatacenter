# OLA VPS Cloud — environment contract.
# Copy to .env.local and fill in. Never commit a filled copy.
# The schema that validates this lives in src/lib/env.ts.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Supabase). One project per environment.
# App: the transaction pooler (Supabase → Connect → "Transaction pooler", port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Migrations only (drizzle-kit): the session pooler or direct connection, port 5432.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Auth.js — at least 32 chars. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-32-plus-character-random-string
AUTH_URL=http://localhost:3000

# ─── Providers: use the mocks locally ────────────────────────────────────────
# true  -> MockOvhClient + MockWhmcsClient + MockEmailSender. No money moves.
# false -> the real adapters, which then require the credentials below.
USE_MOCK_PROVIDERS=true

# ─── OVHcloud ────────────────────────────────────────────────────────────────
# Create the keys at https://eu.api.ovh.com/createToken/ with the minimum rights:
#   GET/POST/PUT/DELETE  /vps/*  /order/*  /me/order/*  /ip/*      and  GET /me
OVH_ENDPOINT=ovh-eu
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SUBSIDIARY=ES
# Kill switch. Real orders only leave the building when this is exactly "true".
# Keep it false everywhere except production (and while testing in staging).
OVH_ORDERS_ENABLED=false

# ─── WHMCS ───────────────────────────────────────────────────────────────────
WHMCS_API_URL=https://panel.cloudin.pro/cdin/includes/api.php
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
# WHMCS allowlists IPs and Vercel has no static egress IP: point this at a small
# fixed-IP proxy that forwards to WHMCS. Leave empty to call WHMCS directly.
WHMCS_PROXY_URL=
# Guard on every WHMCS write. false = the adapter refuses to write.
WHMCS_WRITE_ENABLED=false
# Shared secret for the includes/hooks/ola_vps.php -> /api/webhooks/whmcs HMAC.
WHMCS_WEBHOOK_SECRET=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ─── Jobs (Inngest) ──────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=OLA <cloud@oladc.com>

# ─── SMS for the phone OTP ───────────────────────────────────────────────────
# Provider still to be chosen (see docs/decisions.md). Empty = codes are logged
# to the server console by ConsoleSmsSender.
SMS_PROVIDER_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Business rules (defaults match the brief) ───────────────────────────────
PRICING_DEFAULT_MARGIN=0.75
ADDON_DEFAULT_MARGIN=0.50
WELCOME_CREDIT_CENTS=1000
WELCOME_CREDIT_DAYS=30

# ─── Alerts ──────────────────────────────────────────────────────────────────
ALERTS_EMAIL=
ALERTS_SLACK_WEBHOOK=
