{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@ola/core": ["./packages/core/src/index.ts"],
      "@ola/core/*": ["./packages/core/src/*"],
      "@ola/db": ["./packages/db/src/index.ts"],
      "@ola/db/*": ["./packages/db/src/*"],
      "@ola/ovh": ["./packages/ovh/src/index.ts"],
      "@ola/ovh/*": ["./packages/ovh/src/*"],
      "@ola/whmcs": ["./packages/whmcs/src/index.ts"],
      "@ola/whmcs/*": ["./packages/whmcs/src/*"],
      "@ola/email": ["./packages/email/src/index.ts"],
      "@ola/email/*": ["./packages/email/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "**/node_modules"]
}
