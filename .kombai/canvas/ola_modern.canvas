      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono&display=swap');\n\n  :root {\n    --primary: #00FFC7;\n    --primary-deep: #00CC9F;\n    --violet: #4f46e5;\n    --sky: #38bdf8;\n    --bg: #ffffff;\n    --text: #0f172a;\n    --text-muted: #64748b;\n    --border: #f1f5f9;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    color: var(--text);\n    background-color: var(--bg);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-mono {\n    font-family: 'JetBrains Mono', monospace;\n  }\n\n  /* Gradient Bar Graphic */\n  .bar-container div {\n    height: 12px;\n    background: linear-gradient(90deg, var(--primary) 0%, var(--violet) 50%, var(--primary) 100%);\n    border-radius: 2px;\n    opacity: 0;\n    transform: scaleX(0);\n  }\n\n  /* Nested Tunnel Effect */\n  .tunnel-box div {\n    position: absolute;\n    border: 1px solid rgba(0, 255, 199, 0.2);\n    transition: all 0.3s ease;\n  }\n\n  .tunnel-box:hover div {\n    border-color: rgba(0, 255, 199, 0.6);\n    transform: scale(1.05);\n  }\n\n  /* Chart Styles */\n  .chart-bar {\n    transition: height 1s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .bench-card:hover .chart-bar {\n    filter: brightness(1.1);\n  }\n</style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"2\"></script>\n\n\n<nav class=\"fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md border-b border-gray-100\" data-kid=\"3\">\n  <div class=\"max-w-7xl mx-auto px-8 h-20 flex items-center justify-between\" data-kid=\"4\">\n    <div class=\"flex items-center gap-8\" data-kid=\"5\">\n      <div class=\"flex items-center gap-2\" data-kid=\"6\">\n        <div class=\"w-8 h-8 bg-black flex items-center justify-center rounded-sm\" data-kid=\"7\">\n          <div class=\"w-4 h-4 border-2 border-[var(--primary)] rotate-45\" data-kid=\"8\"></div>\n        </div>\n        <span class=\"text-xl font-bold tracking-tighter\" data-kid=\"9\">OLA</span>\n      </div>\n      <div class=\"hidden md:flex items-center gap-6 text-sm font-medium text-gray-600\" data-kid=\"10\">\n        <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"11\">Product</a>\n        <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"12\">Solutions</a>\n        <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"13\">Docs</a>\n        <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"14\">Pricing</a>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-4\" data-kid=\"15\">\n      <button class=\"text-sm font-medium hover:text-black transition-colors\" data-kid=\"16\">Sign In</button>\n      <button class=\"px-5 py-2.5 bg-black text-white text-sm font-semibold rounded-sm hover:bg-gray-800 transition-all\" data-kid=\"17\">\n        Get Started\n      </button>\n    </div>\n  </div>\n</nav>\n\n\n<section class=\"pt-40 pb-20 px-8 relative overflow-hidden\" data-kid=\"18\">\n  <div class=\"max-w-4xl mx-auto text-center z-10 relative\" data-kid=\"19\">\n    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary-deep)] text-xs font-bold mb-6 tracking-wider uppercase\" data-kid=\"20\">\n      <i class=\"ti ti-sparkles\" data-kid=\"21\"></i>\n      The Future of Cloud\n    </div>\n    <h1 class=\"text-6xl md:text-7xl font-bold tracking-tight mb-8 leading-[1.1]\" data-kid=\"22\">\n      Cloud infrastructure for the <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-[var(--primary)] to-[var(--violet)]\" data-kid=\"23\">agentic stack.</span>\n    </h1>\n    <p class=\"text-xl text-gray-500 mb-12 max-w-2xl mx-auto font-light leading-relaxed\" data-kid=\"24\">\n      Purpose-built hardware and globally distributed networking designed to power the next generation of AI agents and autonomous workflows.\n    </p>\n    <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4 mb-20\" data-kid=\"25\">\n      <button class=\"px-8 py-4 bg-black text-white font-semibold rounded-sm hover:shadow-xl hover:shadow-[var(--primary)]/20 transition-all w-full sm:w-auto\" data-kid=\"26\">\n        Get Started\n      </button>\n      <button class=\"px-8 py-4 border border-gray-200 font-semibold rounded-sm hover:bg-gray-50 transition-all w-full sm:w-auto\" data-kid=\"27\">\n        Book a Demo\n      </button>\n    </div>\n  </div>\n\n  \n  <div class=\"relative flex flex-col items-center gap-1.5 mt-10 bar-container\" id=\"hero-bars\" data-kid=\"28\">\n    \n    <div style=\"width: 80px;\" data-kid=\"29\"></div>\n    <div style=\"width: 160px;\" data-kid=\"30\"></div>\n    <div style=\"width: 240px;\" data-kid=\"31\"></div>\n    <div style=\"width: 320px;\" data-kid=\"32\"></div>\n    <div style=\"width: 400px;\" data-kid=\"33\"></div>\n    <div style=\"width: 480px;\" data-kid=\"34\"></div>\n    <div style=\"width: 560px;\" data-kid=\"35\"></div>\n    <div style=\"width: 640px;\" data-kid=\"36\"></div>\n    <div style=\"width: 560px;\" data-kid=\"37\"></div>\n    <div style=\"width: 480px;\" data-kid=\"38\"></div>\n    <div style=\"width: 400px;\" data-kid=\"39\"></div>\n    <div style=\"width: 320px;\" data-kid=\"40\"></div>\n    <div style=\"width: 240px;\" data-kid=\"41\"></div>\n    <div style=\"width: 160px;\" data-kid=\"42\"></div>\n    <div style=\"width: 80px;\" data-kid=\"43\"></div>\n\n    \n    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-5xl h-full flex items-center justify-center pointer-events-none\" data-kid=\"44\">\n      \n      <div class=\"absolute top-0 left-[10%] p-4 bg-white shadow-2xl rounded-lg border border-gray-100 rotate-[-4deg] opacity-0 translate-y-10 floating-card\" data-kid=\"45\">\n        <div class=\"flex items-center gap-3 mb-3\" data-kid=\"46\">\n          <div class=\"w-8 h-8 rounded bg-blue-50 flex items-center justify-center text-blue-600\" data-kid=\"47\">\n            <i class=\"ti ti-terminal text-lg\" data-kid=\"48\"></i>\n          </div>\n          <span class=\"text-xs font-mono font-bold uppercase tracking-widest text-gray-400\" data-kid=\"49\">Deployment</span>\n        </div>\n        <div class=\"w-48 space-y-2\" data-kid=\"50\">\n          <div class=\"h-1.5 w-full bg-gray-100 rounded-full\" data-kid=\"51\"></div>\n          <div class=\"h-1.5 w-3/4 bg-gray-100 rounded-full\" data-kid=\"52\"></div>\n          <div class=\"h-1.5 w-1/2 bg-[var(--primary)] rounded-full\" data-kid=\"53\"></div>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute bottom-[20%] right-[12%] p-5 bg-white shadow-2xl rounded-lg border border-gray-100 rotate-[3deg] opacity-0 translate-y-10 floating-card\" data-kid=\"54\">\n        <div class=\"flex items-center gap-3 mb-4\" data-kid=\"55\">\n          <div class=\"w-8 h-8 rounded bg-green-50 flex items-center justify-center text-[var(--primary-deep)]\" data-kid=\"56\">\n            <i class=\"ti ti-cpu text-lg\" data-kid=\"57\"></i>\n          </div>\n          <span class=\"text-xs font-mono font-bold text-gray-400\" data-kid=\"58\">CPU UTILIZATION</span>\n        </div>\n        <div class=\"flex items-end gap-1 h-12\" data-kid=\"59\">\n          <div class=\"w-1.5 h-6 bg-gray-100 rounded-t-sm\" data-kid=\"60\"></div>\n          <div class=\"w-1.5 h-10 bg-gray-100 rounded-t-sm\" data-kid=\"61\"></div>\n          <div class=\"w-1.5 h-8 bg-[var(--primary)] rounded-t-sm\" data-kid=\"62\"></div>\n          <div class=\"w-1.5 h-12 bg-[var(--primary)] rounded-t-sm\" data-kid=\"63\"></div>\n          <div class=\"w-1.5 h-5 bg-gray-100 rounded-t-sm\" data-kid=\"64\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"py-32 bg-gray-50/50\" data-kid=\"65\">\n  <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"66\">\n    <div class=\"text-center mb-20\" data-kid=\"67\">\n      <h2 class=\"text-4xl font-bold tracking-tight mb-4\" data-kid=\"68\">Unrivaled performance across complex workloads.</h2>\n      <p class=\"text-gray-500 font-light\" data-kid=\"69\">Industry-best parsing, indexing, and retrieval throughput.</p>\n    </div>\n\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\" data-kid=\"70\">\n      <div class=\"lg:col-span-4 space-y-8\" data-kid=\"71\">\n        <div class=\"p-6 bg-white border border-gray-100 rounded-lg shadow-sm\" data-kid=\"72\">\n          <div class=\"text-3xl font-bold mb-1\" data-kid=\"73\">10k+</div>\n          <div class=\"text-sm font-mono text-gray-400 uppercase tracking-widest\" data-kid=\"74\">Global Clusters</div>\n        </div>\n        <div class=\"p-6 bg-white border border-gray-100 rounded-lg shadow-sm\" data-kid=\"75\">\n          <div class=\"text-3xl font-bold mb-1\" data-kid=\"76\">99.9%</div>\n          <div class=\"text-sm font-mono text-gray-400 uppercase tracking-widest\" data-kid=\"77\">Uptime SLA</div>\n        </div>\n        <div class=\"p-6 bg-white border border-gray-100 rounded-lg shadow-sm\" data-kid=\"78\">\n          <div class=\"text-3xl font-bold mb-1\" data-kid=\"79\">12ms</div>\n          <div class=\"text-sm font-mono text-gray-400 uppercase tracking-widest\" data-kid=\"80\">Average Latency</div>\n        </div>\n      </div>\n\n      <div class=\"lg:col-span-8 bg-white p-10 border border-gray-100 rounded-2xl shadow-sm\" data-kid=\"81\">\n        <div class=\"flex items-center justify-between mb-12\" data-kid=\"82\">\n          <div class=\"flex gap-4\" data-kid=\"83\">\n            <span class=\"text-sm font-bold border-b-2 border-black pb-1\" data-kid=\"84\">Overall Performance</span>\n            <span class=\"text-sm font-medium text-gray-400 cursor-pointer hover:text-black transition-colors\" data-kid=\"85\">Latency</span>\n            <span class=\"text-sm font-medium text-gray-400 cursor-pointer hover:text-black transition-colors\" data-kid=\"86\">Security</span>\n          </div>\n          <div class=\"flex items-center gap-6\" data-kid=\"87\">\n            <div class=\"flex items-center gap-2\" data-kid=\"88\">\n              <div class=\"w-3 h-3 rounded-full bg-[var(--primary)]\" data-kid=\"89\"></div>\n              <span class=\"text-xs font-medium text-gray-500\" data-kid=\"90\">OLA Cloud</span>\n            </div>\n            <div class=\"flex items-center gap-2\" data-kid=\"91\">\n              <div class=\"w-3 h-3 rounded-full bg-gray-200\" data-kid=\"92\"></div>\n              <span class=\"text-xs font-medium text-gray-500\" data-kid=\"93\">Competitors</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"flex items-end justify-between h-[300px] gap-4 px-4 border-b border-gray-100 relative\" data-kid=\"94\">\n          \n          <div class=\"flex-1 flex flex-col items-center group\" data-kid=\"95\">\n            <div class=\"w-16 bg-gradient-to-t from-[var(--violet)] to-[var(--primary)] rounded-t-lg chart-bar h-[92%] relative\" data-kid=\"96\">\n               <div class=\"absolute -top-8 left-1/2 -translate-x-1/2 text-sm font-bold\" data-kid=\"97\">94.8%</div>\n            </div>\n            <span class=\"mt-4 text-xs font-bold uppercase tracking-widest text-gray-400\" data-kid=\"98\">OLA</span>\n          </div>\n          \n          <div class=\"flex-1 flex flex-col items-center\" data-kid=\"99\">\n            <div class=\"w-16 bg-gray-100 rounded-t-lg chart-bar h-[74%] relative\" data-kid=\"100\">\n               <div class=\"absolute -top-8 left-1/2 -translate-x-1/2 text-sm font-medium text-gray-400\" data-kid=\"101\">74.2%</div>\n            </div>\n            <span class=\"mt-4 text-xs font-bold uppercase tracking-widest text-gray-400\" data-kid=\"102\">AWS</span>\n          </div>\n          \n          <div class=\"flex-1 flex flex-col items-center\" data-kid=\"103\">\n            <div class=\"w-16 bg-gray-100 rounded-t-lg chart-bar h-[68%] relative\" data-kid=\"104\">\n               <div class=\"absolute -top-8 left-1/2 -translate-x-1/2 text-sm font-medium text-gray-400\" data-kid=\"105\">68.5%</div>\n            </div>\n            <span class=\"mt-4 text-xs font-bold uppercase tracking-widest text-gray-400\" data-kid=\"106\">GCP</span>\n          </div>\n          \n          <div class=\"flex-1 flex flex-col items-center\" data-kid=\"107\">\n            <div class=\"w-16 bg-gray-100 rounded-t-lg chart-bar h-[62%] relative\" data-kid=\"108\">\n               <div class=\"absolute -top-8 left-1/2 -translate-x-1/2 text-sm font-medium text-gray-400\" data-kid=\"109\">62.1%</div>\n            </div>\n            <span class=\"mt-4 text-xs font-bold uppercase tracking-widest text-gray-400\" data-kid=\"110\">AZURE</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"py-32 px-8\" data-kid=\"111\">\n  <div class=\"max-w-7xl mx-auto\" data-kid=\"112\">\n    <div class=\"mb-20 text-center\" data-kid=\"113\">\n      <h2 class=\"text-4xl font-bold tracking-tight mb-4\" data-kid=\"114\">Built for every data-heavy industry.</h2>\n      <p class=\"text-gray-500 font-light\" data-kid=\"115\">Customized solutions optimized for specific vertical requirements.</p>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\" data-kid=\"116\">\n      \n      <div class=\"group p-8 border border-gray-100 rounded-2xl hover:shadow-xl transition-all duration-500\" data-kid=\"117\">\n        <div class=\"w-full aspect-square mb-8 flex items-center justify-center bg-gray-50 rounded-xl relative overflow-hidden tunnel-box\" data-kid=\"118\">\n          <div class=\"w-40 h-40\" style=\"inset: 0;\" data-kid=\"119\"></div>\n          <div class=\"w-32 h-32\" style=\"inset: 16px;\" data-kid=\"120\"></div>\n          <div class=\"w-24 h-24\" style=\"inset: 32px;\" data-kid=\"121\"></div>\n          <div class=\"w-16 h-16 bg-[var(--primary)]\" style=\"inset: 48px;\" data-kid=\"122\"></div>\n        </div>\n        <h3 class=\"text-xl font-bold mb-3\" data-kid=\"123\">Finance</h3>\n        <p class=\"text-gray-500 text-sm font-light leading-relaxed mb-6\" data-kid=\"124\">\n          High-frequency trading and risk assessment infrastructure with sub-millisecond precision.\n        </p>\n        <a href=\"#\" class=\"text-[var(--primary-deep)] text-xs font-bold uppercase tracking-widest flex items-center gap-2 group-hover:gap-3 transition-all\" data-kid=\"125\">\n          Explore Finance <i class=\"ti ti-arrow-right\" data-kid=\"126\"></i>\n        </a>\n      </div>\n\n      \n      <div class=\"group p-8 border border-gray-100 rounded-2xl hover:shadow-xl transition-all duration-500\" data-kid=\"127\">\n        <div class=\"w-full aspect-square mb-8 flex items-center justify-center bg-gray-50 rounded-xl relative overflow-hidden tunnel-box\" data-kid=\"128\">\n          <div class=\"w-40 h-40\" style=\"inset: 0; border-color: rgba(79, 70, 229, 0.2);\" data-kid=\"129\"></div>\n          <div class=\"w-32 h-32\" style=\"inset: 16px; border-color: rgba(79, 70, 229, 0.4);\" data-kid=\"130\"></div>\n          <div class=\"w-24 h-24\" style=\"inset: 32px; border-color: rgba(79, 70, 229, 0.6);\" data-kid=\"131\"></div>\n          <div class=\"w-16 h-16 bg-violet-600\" style=\"inset: 48px;\" data-kid=\"132\"></div>\n        </div>\n        <h3 class=\"text-xl font-bold mb-3\" data-kid=\"133\">AI & Research</h3>\n        <p class=\"text-gray-500 text-sm font-light leading-relaxed mb-6\" data-kid=\"134\">\n          Training and inference nodes equipped with H100s, optimized for distributed LLM workloads.\n        </p>\n        <a href=\"#\" class=\"text-violet-600 text-xs font-bold uppercase tracking-widest flex items-center gap-2 group-hover:gap-3 transition-all\" data-kid=\"135\">\n          Explore AI <i class=\"ti ti-arrow-right\" data-kid=\"136\"></i>\n        </a>\n      </div>\n\n      \n      <div class=\"group p-8 border border-gray-100 rounded-2xl hover:shadow-xl transition-all duration-500\" data-kid=\"137\">\n        <div class=\"w-full aspect-square mb-8 flex items-center justify-center bg-gray-50 rounded-xl relative overflow-hidden tunnel-box\" data-kid=\"138\">\n          <div class=\"w-40 h-40\" style=\"inset: 0; border-color: rgba(56, 189, 248, 0.2);\" data-kid=\"139\"></div>\n          <div class=\"w-32 h-32\" style=\"inset: 16px; border-color: rgba(56, 189, 248, 0.4);\" data-kid=\"140\"></div>\n          <div class=\"w-24 h-24\" style=\"inset: 32px; border-color: rgba(56, 189, 248, 0.6);\" data-kid=\"141\"></div>\n          <div class=\"w-16 h-16 bg-sky-400\" style=\"inset: 48px;\" data-kid=\"142\"></div>\n        </div>\n        <h3 class=\"text-xl font-bold mb-3\" data-kid=\"143\">Healthcare</h3>\n        <p class=\"text-gray-500 text-sm font-light leading-relaxed mb-6\" data-kid=\"144\">\n          HIPAA-compliant data storage and processing for genomics and patient diagnostics.\n        </p>\n        <a href=\"#\" class=\"text-sky-500 text-xs font-bold uppercase tracking-widest flex items-center gap-2 group-hover:gap-3 transition-all\" data-kid=\"145\">\n          Explore Healthcare <i class=\"ti ti-arrow-right\" data-kid=\"146\"></i>\n        </a>\n      </div>\n\n      \n      <div class=\"group p-8 border border-gray-100 rounded-2xl hover:shadow-xl transition-all duration-500\" data-kid=\"147\">\n        <div class=\"w-full aspect-square mb-8 flex items-center justify-center bg-gray-50 rounded-xl relative overflow-hidden tunnel-box\" data-kid=\"148\">\n          <div class=\"w-40 h-40\" style=\"inset: 0; border-color: rgba(15, 23, 42, 0.1);\" data-kid=\"149\"></div>\n          <div class=\"w-32 h-32\" style=\"inset: 16px; border-color: rgba(15, 23, 42, 0.2);\" data-kid=\"150\"></div>\n          <div class=\"w-24 h-24\" style=\"inset: 32px; border-color: rgba(15, 23, 42, 0.3);\" data-kid=\"151\"></div>\n          <div class=\"w-16 h-16 bg-slate-900\" style=\"inset: 48px;\" data-kid=\"152\"></div>\n        </div>\n        <h3 class=\"text-xl font-bold mb-3\" data-kid=\"153\">Blockchain</h3>\n        <p class=\"text-gray-500 text-sm font-light leading-relaxed mb-6\" data-kid=\"154\">\n          High-availability validator nodes and indexers for next-gen decentralized networks.\n        </p>\n        <a href=\"#\" class=\"text-slate-900 text-xs font-bold uppercase tracking-widest flex items-center gap-2 group-hover:gap-3 transition-all\" data-kid=\"155\">\n          Explore Web3 <i class=\"ti ti-arrow-right\" data-kid=\"156\"></i>\n        </a>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"py-32 bg-white relative overflow-hidden\" data-kid=\"157\">\n  \n  <div class=\"absolute top-0 left-1/2 -translate-x-1/2 opacity-10\" data-kid=\"158\">\n    <svg width=\"400\" height=\"200\" viewBox=\"0 0 400 200\" data-kid=\"159\">\n      <path d=\"M0 200L200 0L400 200\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.5\" data-kid=\"160\"></path>\n      <path d=\"M0 160L200 0L400 160\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.5\" data-kid=\"161\"></path>\n    </svg>\n  </div>\n\n  <div class=\"max-w-4xl mx-auto text-center relative z-10 px-8\" data-kid=\"162\">\n    <h2 class=\"text-5xl font-bold tracking-tight mb-8\" data-kid=\"163\">\n      <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-[var(--primary)] to-[var(--violet)]\" data-kid=\"164\">Enterprise Ready.</span>\n    </h2>\n    <p class=\"text-lg text-gray-500 font-light mb-16\" data-kid=\"165\">\n      Built for teams running production-grade AI with reliability, security, and control at scale.\n    </p>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-12 text-left border-t border-gray-100 pt-16\" data-kid=\"166\">\n      <div data-kid=\"167\">\n        <div class=\"w-10 h-10 rounded bg-gray-50 flex items-center justify-center text-black mb-6\" data-kid=\"168\">\n          <i class=\"ti ti-shield-check\" data-kid=\"169\"></i>\n        </div>\n        <h4 class=\"font-bold mb-2\" data-kid=\"170\">SOC2 & ISO 27001</h4>\n        <p class=\"text-sm text-gray-500 leading-relaxed font-light\" data-kid=\"171\">Global security certifications to meet the strictest compliance standards.</p>\n      </div>\n      <div data-kid=\"172\">\n        <div class=\"w-10 h-10 rounded bg-gray-50 flex items-center justify-center text-black mb-6\" data-kid=\"173\">\n          <i class=\"ti ti-headset\" data-kid=\"174\"></i>\n        </div>\n        <h4 class=\"font-bold mb-2\" data-kid=\"175\">24/7 Support</h4>\n        <p class=\"text-sm text-gray-500 leading-relaxed font-light\" data-kid=\"176\">Dedicated engineering support teams available across all timezones.</p>\n      </div>\n      <div data-kid=\"177\">\n        <div class=\"w-10 h-10 rounded bg-gray-50 flex items-center justify-center text-black mb-6\" data-kid=\"178\">\n          <i class=\"ti ti-git-branch\" data-kid=\"179\"></i>\n        </div>\n        <h4 class=\"font-bold mb-2\" data-kid=\"180\">Multi-cloud Sync</h4>\n        <p class=\"text-sm text-gray-500 leading-relaxed font-light\" data-kid=\"181\">Seamlessly bridge your existing AWS/GCP workloads with OLA bare-metal.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"absolute bottom-0 left-1/2 -translate-x-1/2 opacity-10 rotate-180\" data-kid=\"182\">\n    <svg width=\"400\" height=\"200\" viewBox=\"0 0 400 200\" data-kid=\"183\">\n      <path d=\"M0 200L200 0L400 200\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.5\" data-kid=\"184\"></path>\n    </svg>\n  </div>\n</section>\n\n\n<section class=\"pb-32 px-8\" data-kid=\"185\">\n  <div class=\"max-w-7xl mx-auto bg-black rounded-3xl p-16 text-center text-white relative overflow-hidden\" data-kid=\"186\">\n    <div class=\"absolute top-0 right-0 w-96 h-96 bg-[var(--primary)] blur-[120px] opacity-10\" data-kid=\"187\"></div>\n    <div class=\"absolute bottom-0 left-0 w-96 h-96 bg-[var(--violet)] blur-[120px] opacity-10\" data-kid=\"188\"></div>\n    \n    <div class=\"relative z-10\" data-kid=\"189\">\n      <h2 class=\"text-4xl md:text-5xl font-bold mb-8\" data-kid=\"190\">Ready to deploy your first agent?</h2>\n      <p class=\"text-gray-400 mb-12 max-w-xl mx-auto font-light\" data-kid=\"191\">\n        Join over 10,000 developers building the future of autonomous systems on OLA Cloud.\n      </p>\n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-6\" data-kid=\"192\">\n        <button class=\"px-8 py-4 bg-[var(--primary)] text-black font-bold rounded-sm hover:scale-105 transition-all w-full sm:w-auto\" data-kid=\"193\">\n          Sign Up for Free\n        </button>\n        <button class=\"text-white font-semibold flex items-center gap-2 hover:gap-3 transition-all\" data-kid=\"194\">\n          Contact Sales <i class=\"ti ti-arrow-right\" data-kid=\"195\"></i>\n        </button>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<footer class=\"py-20 border-t border-gray-100\" data-kid=\"196\">\n  <div class=\"max-w-7xl mx-auto px-8 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-12\" data-kid=\"197\">\n    <div class=\"col-span-2\" data-kid=\"198\">\n      <div class=\"flex items-center gap-2 mb-6\" data-kid=\"199\">\n        <div class=\"w-6 h-6 bg-black flex items-center justify-center rounded-xs\" data-kid=\"200\">\n          <div class=\"w-3 h-3 border border-[var(--primary)] rotate-45\" data-kid=\"201\"></div>\n        </div>\n        <span class=\"text-lg font-bold tracking-tighter\" data-kid=\"202\">OLA</span>\n      </div>\n      <p class=\"text-sm text-gray-500 font-light leading-relaxed mb-8 max-w-xs\" data-kid=\"203\">\n        The infrastructure layer for the agentic web. Scalable, secure, and built for builders.\n      </p>\n      <div class=\"flex gap-4\" data-kid=\"204\">\n        <i class=\"ti ti-brand-twitter text-gray-400 hover:text-black cursor-pointer text-xl\" data-kid=\"205\"></i>\n        <i class=\"ti ti-brand-github text-gray-400 hover:text-black cursor-pointer text-xl\" data-kid=\"206\"></i>\n        <i class=\"ti ti-brand-discord text-gray-400 hover:text-black cursor-pointer text-xl\" data-kid=\"207\"></i>\n      </div>\n    </div>\n    \n    <div data-kid=\"208\">\n      <h5 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-gray-400\" data-kid=\"209\">Product</h5>\n      <ul class=\"space-y-4 text-sm text-gray-600 font-medium\" data-kid=\"210\">\n        <li data-kid=\"211\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"212\">Compute</a></li>\n        <li data-kid=\"213\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"214\">Storage</a></li>\n        <li data-kid=\"215\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"216\">Network</a></li>\n        <li data-kid=\"217\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"218\">Managed AI</a></li>\n      </ul>\n    </div>\n    \n    <div data-kid=\"219\">\n      <h5 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-gray-400\" data-kid=\"220\">Resources</h5>\n      <ul class=\"space-y-4 text-sm text-gray-600 font-medium\" data-kid=\"221\">\n        <li data-kid=\"222\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"223\">Documentation</a></li>\n        <li data-kid=\"224\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"225\">API Reference</a></li>\n        <li data-kid=\"226\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"227\">Changelog</a></li>\n        <li data-kid=\"228\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"229\">Blog</a></li>\n      </ul>\n    </div>\n    \n    <div data-kid=\"230\">\n      <h5 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-gray-400\" data-kid=\"231\">Company</h5>\n      <ul class=\"space-y-4 text-sm text-gray-600 font-medium\" data-kid=\"232\">\n        <li data-kid=\"233\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"234\">About Us</a></li>\n        <li data-kid=\"235\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"236\">Careers</a></li>\n        <li data-kid=\"237\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"238\">Press</a></li>\n        <li data-kid=\"239\"><a href=\"#\" class=\"hover:text-black\" data-kid=\"240\">Legal</a></li>\n      </ul>\n    </div>\n  </div>\n  <div class=\"max-w-7xl mx-auto px-8 mt-20 pt-8 border-t border-gray-50 flex justify-between items-center text-xs text-gray-400 font-medium\" data-kid=\"241\">\n    <span data-kid=\"242\">© 2026 OLA Data Center. All rights reserved.</span>\n    <div class=\"flex gap-6\" data-kid=\"243\">\n      <a href=\"#\" class=\"hover:text-black\" data-kid=\"244\">Privacy</a>\n      <a href=\"#\" class=\"hover:text-black\" data-kid=\"245\">Terms</a>\n    </div>\n  </div>\n</footer>\n\n<script data-kid=\"246\">\n  window.addEventListener('load', () => {\n    // GSAP Animation for Hero Bars\n    const bars = document.querySelectorAll('.bar-container div');\n    gsap.to(bars, {\n      opacity: 1,\n      scaleX: 1,\n      duration: 1.2,\n      stagger: {\n        each: 0.05,\n        from: \"center\"\n      },\n      ease: \"power4.out\"\n    });\n\n    // Floating cards entrance\n    gsap.to('.floating-card', {\n      opacity: 1,\n      y: 0,\n      duration: 1,\n      stagger: 0.2,\n      delay: 0.8,\n      ease: \"power3.out\"\n    });\n\n    // Subtle floating animation for cards\n    gsap.to('.floating-card', {\n      y: -15,\n      duration: 3,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\",\n      stagger: 0.5\n    });\n\n    // Chart Animation\n    const observer = new IntersectionObserver((entries) => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          entry.target.style.height = entry.target.dataset.height || entry.target.style.height;\n          observer.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.5 });\n\n    document.querySelectorAll('.chart-bar').forEach(bar => {\n      const targetHeight = bar.style.height;\n      bar.style.height = '0px';\n      bar.dataset.height = targetHeight;\n      observer.observe(bar);\n    });\n  });\n</script>",
