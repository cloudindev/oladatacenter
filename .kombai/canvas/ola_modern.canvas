      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  body {\n    margin: 0;\n    font-family: 'Geist', sans-serif;\n    background-color: #0a0f1c;\n    color: #f8fafc;\n    overflow-x: hidden;\n  }\n\n  .font-mono {\n    font-family: 'Geist Mono', monospace;\n  }\n\n  .text-ola-cyan {\n    color: #00FFC7;\n  }\n\n  .bg-ola-cyan {\n    background-color: #00FFC7;\n  }\n\n  .border-ola-cyan {\n    border-color: #00FFC7;\n  }\n\n  /* Immersive Grid */\n  .grid-bg {\n    background-image: \n      linear-gradient(to right, rgba(0, 255, 199, 0.05) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(0, 255, 199, 0.05) 1px, transparent 1px);\n    background-size: 60px 60px;\n  }\n\n  .radial-mask {\n    mask-image: radial-gradient(circle at center, black 30%, transparent 80%);\n    -webkit-mask-image: radial-gradient(circle at center, black 30%, transparent 80%);\n  }\n\n  /* Glow Effect */\n  .feature-tile {\n    position: relative;\n    overflow: hidden;\n    background-color: #121a2f;\n  }\n\n  .feature-glow {\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(0, 255, 199, 0.15), transparent 50%);\n    opacity: 0;\n    transition: opacity 0.3s ease;\n    pointer-events: none;\n  }\n\n  .feature-tile:hover .feature-glow {\n    opacity: 1;\n  }\n\n  /* Code Syntax Highlighting */\n  .code-cyan { color: #00FFC7; }\n  .code-white { color: #ffffff; }\n  .code-slate { color: #94a3b8; }\n  .code-comment { color: #475569; font-style: italic; }\n\n  /* Pixel Patterns */\n  .pixel-grid {\n    display: grid;\n    grid-template-columns: repeat(6, 1fr);\n    gap: 4px;\n  }\n  .pixel {\n    width: 12px;\n    height: 12px;\n    background-color: #00FFC7;\n  }\n</style>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"1\"></script>\n<script type=\"module\" data-kid=\"2\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  const lenis = new Lenis()\n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n\n  // Feature Grid Interactive Glow\n  document.querySelectorAll('.feature-tile').forEach(tile => {\n    tile.addEventListener('mousemove', e => {\n      const rect = tile.getBoundingClientRect();\n      const x = ((e.clientX - rect.left) / rect.width) * 100;\n      const y = ((e.clientY - rect.top) / rect.height) * 100;\n      tile.style.setProperty('--mouse-x', `${x}%`);\n      tile.style.setProperty('--mouse-y', `${y}%`);\n    });\n  });\n\n  // Hero Animation\n  gsap.from(\".hero-animate\", {\n    y: 50,\n    opacity: 0,\n    duration: 1,\n    stagger: 0.2,\n    ease: \"power4.out\"\n  });\n\n  gsap.from(\".hero-image-animate\", {\n    scale: 0.8,\n    opacity: 0,\n    duration: 1.5,\n    delay: 0.5,\n    ease: \"expo.out\"\n  });\n</script>\n\n<div class=\"min-h-screen flex flex-col\" data-kid=\"3\">\n  \n  <nav class=\"sticky top-0 z-50 flex items-center justify-between px-12 py-6 bg-[#0a0f1c]/80 backdrop-blur-xl border-b border-white/5\" data-kid=\"4\">\n    <div class=\"flex items-center gap-2\" data-kid=\"5\">\n      <div class=\"w-8 h-8 bg-ola-cyan rounded-sm flex items-center justify-center\" data-kid=\"6\">\n        <span class=\"text-black font-bold text-xl\" data-kid=\"7\">O</span>\n      </div>\n      <span class=\"text-2xl font-bold tracking-tight\" data-kid=\"8\">OLA</span>\n    </div>\n    \n    <div class=\"hidden md:flex items-center gap-10 text-sm font-medium text-slate-400\" data-kid=\"9\">\n      <a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"10\">Products</a>\n      <a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"11\">Solutions</a>\n      <a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"12\">Docs</a>\n      <a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"13\">Pricing</a>\n      <a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"14\">Company</a>\n    </div>\n\n    <div class=\"flex items-center gap-6\" data-kid=\"15\">\n      <a href=\"#\" class=\"text-sm font-medium hover:text-ola-cyan transition-colors\" data-kid=\"16\">Sign In</a>\n      <button class=\"px-6 py-2.5 bg-white text-black text-sm font-bold rounded-sm hover:bg-ola-cyan transition-all duration-300\" data-kid=\"17\">\n        Get Started\n      </button>\n    </div>\n  </nav>\n\n  \n  <header class=\"relative pt-32 pb-48 overflow-hidden\" data-kid=\"18\">\n    \n    <div class=\"absolute inset-0 grid-bg radial-mask z-0\" data-kid=\"19\"></div>\n    \n    <div class=\"container mx-auto px-12 relative z-10 flex flex-col items-center text-center\" data-kid=\"20\">\n      <div class=\"hero-animate flex items-center gap-2 px-3 py-1 rounded-full border border-ola-cyan/30 bg-ola-cyan/5 text-ola-cyan text-[10px] font-mono tracking-widest uppercase mb-8\" data-kid=\"21\">\n        <span class=\"relative flex h-2 w-2\" data-kid=\"22\">\n          <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-ola-cyan opacity-75\" data-kid=\"23\"></span>\n          <span class=\"relative inline-flex rounded-full h-2 w-2 bg-ola-cyan\" data-kid=\"24\"></span>\n        </span>\n        V3.1 Now Available\n      </div>\n\n      <h1 class=\"hero-animate text-7xl md:text-8xl font-bold tracking-tighter leading-[0.9] max-w-4xl mb-8\" data-kid=\"25\">\n        Deploy AI Infrastructure. <br data-kid=\"26\">\n        <span class=\"text-ola-cyan\" data-kid=\"27\">Locally. Fast.</span>\n      </h1>\n      \n      <p class=\"hero-animate text-xl text-slate-400 max-w-2xl mb-12\" data-kid=\"28\">\n        A monumental geometric engine for mission-critical workloads. High-performance compute, storage, and networking with human-level precision.\n      </p>\n\n      <div class=\"hero-animate flex flex-col md:flex-row items-center gap-4 mb-20\" data-kid=\"29\">\n        <button class=\"px-10 py-4 bg-white text-black text-lg font-bold rounded-sm hover:bg-ola-cyan transition-all duration-300 shadow-[0_0_30px_rgba(255,255,255,0.1)]\" data-kid=\"30\">\n          Start Building\n        </button>\n        <div class=\"flex items-center gap-3 px-6 py-4 bg-[#121a2f] border border-white/5 rounded-sm font-mono text-sm group cursor-pointer hover:border-ola-cyan/30 transition-colors\" data-kid=\"31\">\n          <span class=\"text-slate-500\" data-kid=\"32\">$</span>\n          <span class=\"text-slate-300\" data-kid=\"33\">npm install @ola/cloud-cli</span>\n          <i class=\"ti ti-copy text-slate-500 group-hover:text-ola-cyan\" data-kid=\"34\"></i>\n        </div>\n      </div>\n\n      \n      <div class=\"hero-image-animate relative w-full max-w-5xl aspect-video\" data-kid=\"35\">\n        <div class=\"absolute inset-0 bg-ola-cyan/20 blur-[120px] rounded-full opacity-30\" data-kid=\"36\"></div>\n        <img src=\"https://images.unsplash.com/photo-1680992046626-418f7e910589?auto=format&w=1440&q=80&fit=crop\" alt=\"High-tech server room\" class=\"w-full h-full object-cover rounded-xl border border-white/10 shadow-2xl brightness-75 contrast-125\" decoding=\"async\" loading=\"lazy\" data-kid=\"37\">\n        \n        <div class=\"absolute -top-10 -left-10 p-6 bg-[#121a2f]/90 backdrop-blur-md border border-white/10 rounded-lg shadow-xl animate-bounce\" style=\"animation-duration: 4s;\" data-kid=\"38\">\n           <div class=\"flex items-center gap-3 mb-4\" data-kid=\"39\">\n             <i class=\"ti ti-activity text-ola-cyan text-2xl\" data-kid=\"40\"></i>\n             <div class=\"text-xs font-mono\" data-kid=\"41\">SYSTEM HEALTH: 100%</div>\n           </div>\n           <div class=\"w-32 h-1 bg-white/10 rounded-full overflow-hidden\" data-kid=\"42\">\n             <div class=\"w-full h-full bg-ola-cyan\" data-kid=\"43\"></div>\n           </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"py-32 bg-[#0a0f1c] border-y border-white/5\" data-kid=\"44\">\n    <div class=\"container mx-auto px-12\" data-kid=\"45\">\n      <div class=\"flex flex-col md:flex-row items-end justify-between mb-20 gap-8\" data-kid=\"46\">\n        <div class=\"max-w-xl\" data-kid=\"47\">\n          <h2 class=\"text-sm font-mono text-ola-cyan uppercase tracking-widest mb-4\" data-kid=\"48\">// Core Infrastructure</h2>\n          <h3 class=\"text-5xl font-bold tracking-tight\" data-kid=\"49\">Scale with zero ops complexity.</h3>\n        </div>\n        <p class=\"text-slate-400 max-w-xs text-sm\" data-kid=\"50\">\n          Everything you need to run, scale, and monitor your agentic stack globally.\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 bg-white/5 gap-[1px] border border-white/5\" data-kid=\"51\">\n        \n        <div class=\"feature-tile p-10 group\" data-kid=\"52\">\n          <div class=\"feature-glow\" data-kid=\"53\"></div>\n          <i class=\"ti ti-cpu text-3xl mb-6 text-ola-cyan/50 group-hover:text-ola-cyan transition-colors\" data-kid=\"54\"></i>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"55\">Native Runtimes</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\" data-kid=\"56\">High-performance environments for nearly every popular framework, optimized at the kernel level.</p>\n        </div>\n        \n        <div class=\"feature-tile p-10 group\" data-kid=\"57\">\n          <div class=\"feature-glow\" data-kid=\"58\"></div>\n          <i class=\"ti ti-code text-3xl mb-6 text-ola-cyan/50 group-hover:text-ola-cyan transition-colors\" data-kid=\"59\"></i>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"60\">Infrastructure as Code</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\" data-kid=\"61\">Define, deploy, and version your entire architecture with a single YAML configuration file.</p>\n        </div>\n        \n        <div class=\"feature-tile p-10 group\" data-kid=\"62\">\n          <div class=\"feature-glow\" data-kid=\"63\"></div>\n          <i class=\"ti ti-server-bolt text-3xl mb-6 text-ola-cyan/50 group-hover:text-ola-cyan transition-colors\" data-kid=\"64\"></i>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"65\">Isolated Environments</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\" data-kid=\"66\">Prevent non-production services from accessing production resources with zero overhead.</p>\n        </div>\n        \n        <div class=\"feature-tile p-10 group\" data-kid=\"67\">\n          <div class=\"feature-glow\" data-kid=\"68\"></div>\n          <i class=\"ti ti-network text-3xl mb-6 text-ola-cyan/50 group-hover:text-ola-cyan transition-colors\" data-kid=\"69\"></i>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"70\">Edge Caching</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\" data-kid=\"71\">Serve static assets faster with our global CDN, strategically positioned for minimal latency.</p>\n        </div>\n        \n        <div class=\"feature-tile p-10 group\" data-kid=\"72\">\n          <div class=\"feature-glow\" data-kid=\"73\"></div>\n          <i class=\"ti ti-database text-3xl mb-6 text-ola-cyan/50 group-hover:text-ola-cyan transition-colors\" data-kid=\"74\"></i>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"75\">Managed Postgres</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\" data-kid=\"76\">Enterprise-grade databases with point-in-time recovery and seamless read replicas.</p>\n        </div>\n        \n        <div class=\"feature-tile p-10 group\" data-kid=\"77\">\n          <div class=\"feature-glow\" data-kid=\"78\"></div>\n          <i class=\"ti ti-shield-bolt text-3xl mb-6 text-ola-cyan/50 group-hover:text-ola-cyan transition-colors\" data-kid=\"79\"></i>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"80\">Security by Design</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\" data-kid=\"81\">Built-in DDoS protection and encrypted-at-rest storage for all your mission-critical data.</p>\n        </div>\n        \n        <div class=\"feature-tile p-10 group\" data-kid=\"82\">\n          <div class=\"feature-glow\" data-kid=\"83\"></div>\n          <i class=\"ti ti-terminal-2 text-3xl mb-6 text-ola-cyan/50 group-hover:text-ola-cyan transition-colors\" data-kid=\"84\"></i>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"85\">Agent SDKs</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\" data-kid=\"86\">Lightweight SDKs designed specifically for document agents and autonomous workflows.</p>\n        </div>\n        \n        <div class=\"feature-tile p-10 group\" data-kid=\"87\">\n          <div class=\"feature-glow\" data-kid=\"88\"></div>\n          <i class=\"ti ti-chart-dots text-3xl mb-6 text-ola-cyan/50 group-hover:text-ola-cyan transition-colors\" data-kid=\"89\"></i>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"90\">Real-time Metrics</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\" data-kid=\"91\">Stream telemetry to external tools or monitor everything from our integrated dashboard.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32\" data-kid=\"92\">\n    <div class=\"container mx-auto px-12 text-center mb-20\" data-kid=\"93\">\n      <h2 class=\"text-5xl font-bold tracking-tight mb-6\" data-kid=\"94\">Workflows as Code</h2>\n      <p class=\"text-slate-400 max-w-2xl mx-auto\" data-kid=\"95\">\n        Deploy durable, long-running processes without wiring up complex queues or retry logic.\n      </p>\n    </div>\n    \n    <div class=\"container mx-auto px-12\" data-kid=\"96\">\n      <div class=\"max-w-5xl mx-auto bg-[#121a2f] border border-white/10 rounded-xl overflow-hidden shadow-2xl\" data-kid=\"97\">\n        \n        <div class=\"px-6 py-4 bg-[#0a0f1c] border-b border-white/10 flex items-center justify-between\" data-kid=\"98\">\n          <div class=\"flex items-center gap-2\" data-kid=\"99\">\n            <div class=\"w-3 h-3 rounded-full bg-red-500/50\" data-kid=\"100\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-yellow-500/50\" data-kid=\"101\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-green-500/50\" data-kid=\"102\"></div>\n          </div>\n          <div class=\"text-xs font-mono text-slate-500 tracking-widest\" data-kid=\"103\">OLA-CLOUD-CLI - OLA-INFRA.YAML</div>\n          <div class=\"w-12\" data-kid=\"104\"></div>\n        </div>\n        \n        <div class=\"p-10 font-mono text-sm leading-relaxed overflow-x-auto\" data-kid=\"105\">\n          <pre data-kid=\"106\"><code><span class=\"code-comment\"># OLA Cloud Configuration</span>\n<span class=\"code-cyan\">version:</span> <span class=\"code-white\">\"3.1\"</span>\n<span class=\"code-cyan\">services:</span>\n  <span class=\"code-cyan\">agent-processor:</span>\n    <span class=\"code-cyan\">type:</span> <span class=\"code-white\">web-service</span>\n    <span class=\"code-cyan\">runtime:</span> <span class=\"code-white\">nodejs20</span>\n    <span class=\"code-cyan\">plan:</span> <span class=\"code-white\">pro</span>\n    <span class=\"code-cyan\">region:</span> <span class=\"code-white\">us-east-1</span>\n    <span class=\"code-cyan\">env:</span>\n      <span class=\"code-slate\">- OLA_API_KEY=${SECRET_KEY}</span>\n      <span class=\"code-slate\">- WORKFLOW_MODE=AGENTIC</span>\n    <span class=\"code-cyan\">scaling:</span>\n      <span class=\"code-cyan\">min_instances:</span> <span class=\"code-white\">2</span>\n      <span class=\"code-cyan\">max_instances:</span> <span class=\"code-white\">100</span>\n      <span class=\"code-cyan\">target_cpu:</span> <span class=\"code-white\">75%</span>\n\n  <span class=\"code-cyan\">knowledge-base:</span>\n    <span class=\"code-cyan\">type:</span> <span class=\"code-white\">postgres</span>\n    <span class=\"code-cyan\">version:</span> <span class=\"code-white\">16</span>\n    <span class=\"code-cyan\">storage:</span> <span class=\"code-white\">512GB</span>\n    <span class=\"code-cyan\">backups:</span> <span class=\"code-white\">enabled</span></code></pre>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"mt-auto bg-[#04060b] pt-32 pb-12 relative overflow-hidden\" data-kid=\"107\">\n    \n    <div class=\"absolute bottom-0 left-0 p-12 opacity-50\" data-kid=\"108\">\n      <div class=\"pixel-grid\" data-kid=\"109\">\n        <div class=\"pixel\" data-kid=\"110\"></div><div class=\"pixel\" data-kid=\"111\"></div><div class=\"pixel\" data-kid=\"112\"></div><div class=\"pixel\" data-kid=\"113\"></div><div class=\"pixel\" data-kid=\"114\"></div><div class=\"pixel\" data-kid=\"115\"></div>\n        <div class=\"pixel\" data-kid=\"116\"></div><div class=\"pixel\" data-kid=\"117\"></div><div class=\"pixel\" data-kid=\"118\"></div><div class=\"pixel\" data-kid=\"119\"></div><div class=\"pixel opacity-50\" data-kid=\"120\"></div><div class=\"pixel opacity-25\" data-kid=\"121\"></div>\n        <div class=\"pixel\" data-kid=\"122\"></div><div class=\"pixel\" data-kid=\"123\"></div><div class=\"pixel\" data-kid=\"124\"></div><div class=\"pixel opacity-25\" data-kid=\"125\"></div>\n        <div class=\"pixel\" data-kid=\"126\"></div><div class=\"pixel\" data-kid=\"127\"></div>\n        <div class=\"pixel\" data-kid=\"128\"></div>\n      </div>\n    </div>\n    <div class=\"absolute bottom-0 right-0 p-12 opacity-50 transform scale-x-[-1]\" data-kid=\"129\">\n      <div class=\"pixel-grid\" data-kid=\"130\">\n        <div class=\"pixel\" data-kid=\"131\"></div><div class=\"pixel\" data-kid=\"132\"></div><div class=\"pixel\" data-kid=\"133\"></div><div class=\"pixel\" data-kid=\"134\"></div><div class=\"pixel\" data-kid=\"135\"></div><div class=\"pixel\" data-kid=\"136\"></div>\n        <div class=\"pixel\" data-kid=\"137\"></div><div class=\"pixel\" data-kid=\"138\"></div><div class=\"pixel\" data-kid=\"139\"></div><div class=\"pixel\" data-kid=\"140\"></div><div class=\"pixel opacity-50\" data-kid=\"141\"></div><div class=\"pixel opacity-25\" data-kid=\"142\"></div>\n        <div class=\"pixel\" data-kid=\"143\"></div><div class=\"pixel\" data-kid=\"144\"></div><div class=\"pixel\" data-kid=\"145\"></div><div class=\"pixel opacity-25\" data-kid=\"146\"></div>\n        <div class=\"pixel\" data-kid=\"147\"></div><div class=\"pixel\" data-kid=\"148\"></div>\n        <div class=\"pixel\" data-kid=\"149\"></div>\n      </div>\n    </div>\n\n    <div class=\"container mx-auto px-12 relative z-10\" data-kid=\"150\">\n      <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-12 mb-32\" data-kid=\"151\">\n        <div class=\"col-span-2\" data-kid=\"152\">\n          <div class=\"flex items-center gap-2 mb-8\" data-kid=\"153\">\n            <div class=\"w-8 h-8 bg-ola-cyan rounded-sm flex items-center justify-center\" data-kid=\"154\">\n              <span class=\"text-black font-bold text-xl\" data-kid=\"155\">O</span>\n            </div>\n            <span class=\"text-2xl font-bold tracking-tight\" data-kid=\"156\">OLA</span>\n          </div>\n          <p class=\"text-slate-500 text-sm max-w-xs mb-8\" data-kid=\"157\">\n            Intuitive infrastructure to scale any app or agent from your first user to your billionth.\n          </p>\n          <div class=\"flex items-center gap-4 text-slate-400\" data-kid=\"158\">\n            <a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"159\"><i class=\"ti ti-brand-x\" data-kid=\"160\"></i></a>\n            <a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"161\"><i class=\"ti ti-brand-github\" data-kid=\"162\"></i></a>\n            <a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"163\"><i class=\"ti ti-brand-linkedin\" data-kid=\"164\"></i></a>\n          </div>\n        </div>\n        \n        <div data-kid=\"165\">\n          <h5 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-slate-500\" data-kid=\"166\">Products</h5>\n          <ul class=\"space-y-4 text-sm text-slate-400\" data-kid=\"167\">\n            <li data-kid=\"168\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"169\">Compute</a></li>\n            <li data-kid=\"170\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"171\">Managed Databases</a></li>\n            <li data-kid=\"172\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"173\">Object Storage</a></li>\n            <li data-kid=\"174\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"175\">Cloud Workflows</a></li>\n          </ul>\n        </div>\n\n        <div data-kid=\"176\">\n          <h5 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-slate-500\" data-kid=\"177\">Developers</h5>\n          <ul class=\"space-y-4 text-sm text-slate-400\" data-kid=\"178\">\n            <li data-kid=\"179\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"180\">Documentation</a></li>\n            <li data-kid=\"181\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"182\">API Reference</a></li>\n            <li data-kid=\"183\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"184\">Guides</a></li>\n            <li data-kid=\"185\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"186\">Changelog</a></li>\n          </ul>\n        </div>\n\n        <div data-kid=\"187\">\n          <h5 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-slate-500\" data-kid=\"188\">Company</h5>\n          <ul class=\"space-y-4 text-sm text-slate-400\" data-kid=\"189\">\n            <li data-kid=\"190\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"191\">About Us</a></li>\n            <li data-kid=\"192\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"193\">Careers</a></li>\n            <li data-kid=\"194\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"195\">Blog</a></li>\n            <li data-kid=\"196\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"197\">Security</a></li>\n          </ul>\n        </div>\n\n        <div data-kid=\"198\">\n          <h5 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-slate-500\" data-kid=\"199\">Legal</h5>\n          <ul class=\"space-y-4 text-sm text-slate-400\" data-kid=\"200\">\n            <li data-kid=\"201\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"202\">Privacy</a></li>\n            <li data-kid=\"203\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"204\">Terms</a></li>\n            <li data-kid=\"205\"><a href=\"#\" class=\"hover:text-ola-cyan transition-colors\" data-kid=\"206\">Cookie Policy</a></li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"flex flex-col md:flex-row items-center justify-between pt-12 border-t border-white/5 text-xs text-slate-500 gap-4\" data-kid=\"207\">\n        <div data-kid=\"208\">© 2026 OLA CLOUD INFRASTRUCTURE. ALL RIGHTS RESERVED.</div>\n        <div class=\"flex items-center gap-6\" data-kid=\"209\">\n          <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"210\">SYSTEM STATUS: ALL SYSTEMS OPERATIONAL</a>\n          <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"211\">TRUST CENTER</a>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>",
